# Secrets
.env
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Data — never commit footage or large derived artifacts.
# Excludes the *contents* of data/ rather than data/ itself: git cannot re-include a file
# whose parent directory is excluded, so "/data/" would make the exception below dead.
/data/*
!/data/.gitkeep

# Hand-made ground truth is an input, not a derived artifact: it costs human time to
# produce, cannot be regenerated by rerunning anything, and is what every accuracy
# number is measured against. It is small text. It gets versioned.
!/data/groundtruth/

# nfl_data_py local cache
.nfl_cache/

# Models / weights
*.pt
*.onnx
*.engine

# OS
.DS_Store
